# Copy to backend/.env and fill in.

# PostgreSQL with pgvector. Leave unset to use a local SQLite file (backend/stusupport.db).
# DATABASE_URL=postgresql+psycopg://stusupport:stusupport@localhost:5432/stusupport

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720

CORS_ORIGINS=http://localhost:5173

# Risk bands on predicted dropout probability
RISK_MEDIUM_THRESHOLD=0.35
RISK_HIGH_THRESHOLD=0.65

# Counselor (Qwen via Groq). Without a key the assistant returns retrieved policy text only.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
INSTITUTION_NAME=Your Institution

# RAG
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4
